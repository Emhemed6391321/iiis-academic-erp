APP_NAME="المعهد التخصصي"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
# سر الـ bypass لـ ShieldedFeature (للبيئة المحلية فقط — لا تضعه في الإنتاج)
DEV_BYPASS_SECRET=

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============================================================
# قاعدة البيانات — يُنصح بـ MySQL في الإنتاج
# DB_CONNECTION=sqlite مناسب للتطوير المحلي فقط
# ============================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=academic_system
DB_USERNAME=db_user
DB_PASSWORD=

# ------------------------------------------------------------
# Cache, sessions and queues: choose one profile.
# Profile A (default, small installs): all three in the database.
# Profile B (recommended with many branches working at once): Redis, one database each, so the live sync and
#   concurrent branch work do not load MySQL. Uncomment the three Redis lines below and comment out the database ones.
#   Redis must be reachable from the web server and from the queue worker (php artisan queue:work redis --queue=default).
# SESSION_DRIVER=redis
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# REDIS_SESSION_DB=2   (sessions)   REDIS_CACHE_DB=1 (cache)   REDIS_QUEUE_DB=3 (queues)
# ------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.your-mail-provider.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Security
MFA_ENABLED=true
# super_admin and every hq_* account must use MFA; keep this true in production
MFA_ENFORCE_HQ=true
# HMAC secret that signs official documents. Required: signing and verification stop without it.
# Generate one with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# When upgrading a server whose documents were signed before this key existed, set it to the current APP_KEY value
# so those documents stay verifiable, then rotate only after re-issuing them.
DOCUMENT_SIGNATURE_KEY=
# Comma-separated proxy IPs/CIDRs (or * only if behind a trusted load balancer). Empty = trust no proxy headers.
TRUSTED_PROXIES=
DEV_BYPASS_SECRET=
